# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# protected directory — never read, scan, or commit (exact rule, root only)
/wallhaze/

# private media review workspace — local-only originals, quarantined
# derivatives and raw renders. Metadata-only audit trail lives in
# apps/web/data/media-rights.json. Ignoring this directory does not untrack
# already-tracked files; untracking is a separate controlled Git step.
apps/web/private-media/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
