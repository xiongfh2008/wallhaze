# =============================================================================
# WallHaze compose interpolation — STAGING template.
#
# Copy to /opt/wallhaze/secrets/compose.env (chmod 600). Loaded ONLY by
# docker compose (CLI interpolation of compose.production.yaml); it is NOT
# visible inside any container. api.env (from .env.staging.example) is the
# container-side file — keep the two separate.
#
# Placeholders only — never commit real values.
# =============================================================================

# Nginx server_name for the future public staging site. NOT used until you
# enable nginx/api.wallhaze.com.conf (renamed for the staging domain); the
# localhost phase deploys the stack without any public Nginx site.
SITE_DOMAIN=staging.placeholder.invalid

# PostgreSQL container bootstrap (compose services + jobs read these).
# POSTGRES_PASSWORD must equal the password inside DATABASE_URL in api.env.
POSTGRES_DB=wallhaze
POSTGRES_USER=wallhaze
POSTGRES_PASSWORD=PLACEHOLDER_STAGING_DB_PASSWORD
