# WallHaze API (apps/api) — environment template. Copy to .env and edit.
# Server-only configuration: NEVER expose FAL_KEY / DATABASE_URL / payment
# keys to the web app, and NEVER prefix them with NEXT_PUBLIC_.

# ---- Runtime ----
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development
# Comma-separated exact Origin allowlist (no wildcard, no trailing slash).
# Also feeds CORS, the Origin write guard and the checkout redirect allowlist.
CORS_ALLOWED_ORIGINS=http://localhost:3100
# Public site origin (optional; extends the origin allowlist only).
# SITE_URL=https://wallhaze.example
# Global JSON body limit in bytes (default 1 MiB). Generation routes override
# this with a 10 MiB cap (reference images are ≤5 MiB decoded).
BODY_LIMIT_BYTES=1048576
# Only set behind a trusted reverse proxy (reads X-Real-IP).
TRUST_PROXY=
# "1" pauses generation (503 on the sync route; workers claim nothing).
GENERATION_PAUSED=

# ---- Business services (required for auth/credits/jobs) ----
# Without DATABASE_URL the API serves only health, sync generation and the
# image proxy — the business routes are not registered. For LOCAL development
# without PostgreSQL, set PGLITE_DIR (single-process, never for production).
# DATABASE_URL=postgres://user:password@localhost:5432/wallhaze
# Single-process local database. Use `npm run stop` (graceful, writes a backup)
# instead of killing the process.
PGLITE_DIR=.data/pglite-dev

# AI provider — server only, never logged, never sent to clients.
# Leave FAL_KEY empty and set FAL_MOCK=1 for development (no paid calls).
FAL_KEY=
FAL_MOCK=1
# REAL paid calls require this SECOND explicit opt-in: FAL_LIVE_ENABLED=1 AND
# a non-empty FAL_KEY. A key alone never enables billing, and FAL_MOCK=1 wins.
# FAL_LIVE_ENABLED=

# ---- Payments ----
# "waffo" for real checkout; "mock" only for development/test. Production
# refuses to boot with the mock adapter.
PAYMENT_PROVIDER=mock
PAYMENT_ENVIRONMENT=test
# WAFFO_MERCHANT_ID=MER_...
# WAFFO_STORE_ID=STO_...
# WAFFO_PRIVATE_KEY=   # RSA private key: PEM or raw base64 (server-only!)
# Mock adapter secret (development/test only).
PAYMENT_MOCK_SECRET=change-me-dev-only

# Private image storage directory. Unset = in-memory (lost on restart).
# STORAGE_DIR=./.data/images

# --- Cloudflare R2 (optional; requires STORAGE_DRIVER=r2) ---------------------
# STORAGE_DRIVER=local
# Account-level S3 endpoint (no bucket path), region is always "auto".
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Private bucket for user-generated media (never public).
# R2_BUCKET=
# Public/verified media bucket (Gallery/Community); reserved for the
# public-media pipeline.
# R2_PUBLIC_BUCKET=

# ---- Media lifecycle ----
# Newly generated user media expires after 30 days (set by the server at
# completion). Existing rows are migration-marked "legacy" and are NEVER
# selected by the sweep. The ops sweep is a DRY RUN unless this explicit
# flag is set AND STORAGE_DIR points at the real object store:
# MEDIA_RETENTION_CLEANUP_ENABLED=1
# Run: npm run ops -- --no-sweep --no-replay

# HMAC secret for signed private image URLs. REQUIRED when NODE_ENV=production.
# IMAGE_URL_SECRET=

# Persisted per-user daily AI cost budget, in micro units (1e-6 USD).
# USER_DAILY_COST_LIMIT_MICROS=20000000
# Platform-wide daily AI cost budget, in micro units. 0 = hard stop.
# Each job reserves the conservative cost bound (currently 4,000,000 = $4).
# PLATFORM_DAILY_COST_LIMIT_MICROS=4000000
# Operator pause for async job creation and worker claims.
# GENERATION_PAUSED=1

# ---- Google OAuth (optional) ----
# Create an OAuth client (Web application) in Google Cloud Console and register
# this exact redirect URI:
#   http://localhost:4000/v1/auth/oauth/google/callback
# Without both values the API reports { google: false } and the web shows an
# honest "not configured" state — no fake sign-in.
# GOOGLE_CLIENT_ID=....apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/v1/auth/oauth/google/callback
# Public API base URL (used when the redirect URI is not set explicitly).
# API_PUBLIC_URL=http://localhost:4000
# Where the browser returns after OAuth; defaults to the first CORS origin.
# WEB_APP_URL=http://localhost:3100
# HMAC secret for the OAuth state cookie. REQUIRED when Google is configured;
# must be independent from IMAGE_URL_SECRET and at least 32 characters.
# Generate (do not reuse another key):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# OAUTH_STATE_SECRET=

# ---- Worker tuning ----
# "1" runs the worker inside the API process. REQUIRED with PGLITE_DIR because
# PGlite is single-process; production uses a separate `npm run worker`.
EMBED_WORKER=1
WORKER_POLL_MS=2000
WORKER_LEASE_SECONDS=300

# ---- Local operations (development only) ----
# Token for POST /internal/shutdown, used by `npm run stop` so a restart closes
# PGlite cleanly. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The endpoint is not registered without it, and never in production.
# OPS_SHUTDOWN_TOKEN=

# ---- Reserved for a real object store ----
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=

# Separate explicit opt-in for PAID video generation.
# Both FAL_LIVE_ENABLED=1 and FAL_VIDEO_LIVE_ENABLED=1 (plus FAL_KEY) are required.
FAL_VIDEO_LIVE_ENABLED=0
