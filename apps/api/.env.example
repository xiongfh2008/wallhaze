# WallHaze API (apps/api) — environment template. Copy to .env.local and edit.
# Server-only configuration: NEVER expose FAL_KEY / DATABASE_URL / payment
# keys to the web app, and NEVER prefix them with NEXT_PUBLIC_.

# ---- Runtime (active in T04-S1) ----
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
# Comma-separated exact Origin allowlist (no wildcard, no trailing slash).
# Example: http://localhost:3100,https://wallhaze.com
CORS_ALLOWED_ORIGINS=http://localhost:3100
# Global JSON body limit in bytes (default 1 MiB). /v1/generations overrides
# this with its own 10 MiB cap, mirroring the legacy request-guard limit.
BODY_LIMIT_BYTES=1048576

# ---- Reserved for T04-B and later (do not fill yet) ----
# DATABASE_URL=
# FAL_KEY=
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# PAYMENT_PROVIDER=
# PAYMENT_API_KEY=
# PAYMENT_WEBHOOK_SECRET=
