{
  "name": "@wallhaze/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "rights:check": "node scripts/media/check-rights.mjs",
    "rights:build": "node scripts/media/build-rights-registry.mjs",
    "community:import": "node scripts/community/import-submission.mjs",
    "community:unpublish": "node scripts/community/unpublish.mjs",
    "community:demo:prepare": "node scripts/community/sync-demo-media.mjs",
    "community:demo:clean": "node scripts/community/sync-demo-media.mjs --remove",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.2.0",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "cf": "^1.0.0-beta.21",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vitest": "4.1.12"
  },
  "type": "module"
}
