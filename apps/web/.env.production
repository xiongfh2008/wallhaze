# Production build env for vinext (Cloudflare Git build + local vinext builds).
#
# vinext follows NEXT.JS dotenv precedence:
#   process.env > .env.production.local > .env.local > .env.production > .env
# This file is tracked by git (un-ignored via .gitignore) because the
# Cloudflare Git build has none of the local files: without it CI would bake
# an EMPTY NEXT_PUBLIC_API_BASE_URL. It contains NO secrets — only the public
# API base URL. Local overrides go into .env.production.local (gitignored).
# Guarded by scripts/verify-api-base.mjs: the production build REFUSES to run
# when the resolved value is empty or points at localhost / 127.0.0.1.
NEXT_PUBLIC_API_BASE_URL=https://api.wallhaze.com

# Microsoft Clarity analytics (project ID — not a secret). Unset locally in
# dev: the script only renders when this value exists at build time.
NEXT_PUBLIC_CLARITY_ID=z8xwv176sl
