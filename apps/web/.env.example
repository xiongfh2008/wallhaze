# WallHaze web (apps/web) — environment template. Copy to .env.local and edit.
# NEVER put server secrets (FAL_KEY, DATABASE_URL, payment keys) in this app,
# and never expose them with the NEXT_PUBLIC_ prefix.

# Base URL of the standalone WallHaze API (apps/api), no trailing slash.
# Example: http://localhost:4000
# When empty or unset, AI generation shows an explicit "unavailable" state
# and no request is sent to any generation backend.
NEXT_PUBLIC_API_BASE_URL=
